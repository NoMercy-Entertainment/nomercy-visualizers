		"init_eqs_eel": "",
		"frame_eqs_eel": "warp = 0;\nib_r = 0.6 + 0.4*sin(time*0.894);\nib_g = 0.43 + 0.13*sin(time*7.143);\nib_b = 0.5+ 0.33*sin(time*0.465);\nthresh = above(bass_att,thresh)*2+(1-above(bass_att,thresh))*((thresh-1.3)*0.96+1.3);\ndx_r = equal(thresh,2)*0.004*sin(5*time)+(1-equal(thresh,2))*dx_r;\ndy_r = equal(thresh,2)*0.004*sin(6*time)+(1-equal(thresh,2))*dy_r;\ndx = 1.1* dx_r;\ndy = 1.1* dy_r;\nq2 = dx + if(above(bass+bass_att,2.6), 11*dx_r, 0);\nq2 =q2*15 +  if(above(dx_r,0),0.04 + 0.01*sin(time*0.573),-0.04+ 0.01*sin(time*0.573));\nmv_l =10000;\nmv_y =2.0;\nmv_dy = -0.1;\nmv_r =0.7+0.148*(ib_r+ib_b);\nmv_b =1-0.2*(ib_r+ib_b);\nmv_g =0.6+ 0.19*(ib_g+ib_r);\nzoom = zoom -0.02*thresh + 0.01;\nwave_r = ib_r;\nwave_b = ib_b;\nwave_g = ib_g;\nob_r = 1-ib_g;\nob_b = 0.5*(ib_r+ib_g);",
