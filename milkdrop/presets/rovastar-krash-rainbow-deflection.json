		"init_eqs_eel": "",
		"frame_eqs_eel": "warp=0;\ndx=-0.0005;\ndy=-0.0005;\nwave_x = rand(100)/100;\nwave_r = 1 + sin(-wave_x*3.1415);\nwave_g = abs(sin(2*wave_x*3.1415));\nwave_b = sin(wave_x*3.1415);\ntreb_effect = if(above(treb_att,1.4),pow(0.99,treb_att),1);\nnet_effect = if(above(bass_att,0.8*treb_att),1,treb_effect);\nzoom = net_effect;\nrot = rot + rot_residual;\nbass_thresh = above(bass_att,bass_thresh)*2 + (1-above(bass_att,bass_thresh))*((bass_thresh-1.3)*0.96+1.3);\nshift = (tan(time*7)) -0.05;\nshift = if(above(shift,0),0,if(below(shift,-0.1),-0.1,shift));\nrot_residual = if(equal(bass_thresh,2),shift,rot_residual);",
