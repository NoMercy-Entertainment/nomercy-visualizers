		"init_eqs_eel": "",
		"frame_eqs_eel": "wave_r = wave_r + 0.35*sin(1.4*time) + 0.25*sin(2.5*time);\nwave_g = wave_g + 0.35*sin(1.7*time) - 0.25*sin(1.11*time);\nwave_b = wave_b + 0.35*sin(1.84*time) + 0.25*sin(2.3*time);\nwarp = 0;",
