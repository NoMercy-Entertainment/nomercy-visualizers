		"init_eqs_eel": "",
		"frame_eqs_eel": "wave_b = rand(100)/100;\nwave_r = rand(100)/100;\nwave_g = rand(100)/100;\nwave_y =wave_y-ypos*q3;\nwave_x =wave_x-xpos*q3;\nbass_eff = max(max(bass,bass_att)-1,0);\nbass_thresh = above(bass_att,bass_thresh)*2 + (1-above(bass_att,bass_thresh))*((bass_thresh-1.3)*0.96+1.3);\nvol =bass+treb+mid;\ndx = 0.005 + q3*( 0.60*sin(0.234*time) + 0.40*sin(0.277*time) );\ndy = 0.005 + q3*( 0.60*sin(0.234*time) + 0.40*sin(0.277*time) );\ndx_residual = equal(bass_thresh,2)*0.016*sin(time*7) + (q2-equal(bass_thresh,2))*dx_residual;\ndy_residual = equal(bass_thresh,2)*0.012*sin(time*9) + (q2-equal(bass_thresh,2))*dy_residual;\nrot = q3 + 0.030*( 0.60*sin(0.381*time) + 0.40*sin(0.479*time) );\nob_size=mytime*q3;\nib_a=1-mytime+bass;\nib_r =rand(100)/100;\nib_b =rand(100)/100;\nib_g =rand(100)/100;\nmytime=.5;\nq1=sin(time*mytime*4);\nq2=sin(time*mytime*2);\nq3=abs(rad-.5)*q2;\nxpos=.5;\nypos=.5;\nmonitor =q3;",
