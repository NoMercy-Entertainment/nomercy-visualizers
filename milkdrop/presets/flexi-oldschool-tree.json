		"init_eqs_eel": "x1 = 0.9;\ny1 = 0.5;\n\nx2 = 0.5; y2 = 0.5;\nx3 = 0.5; y3 = 0.5;\nx4 = 0.5; y4 = 0.5;",
		"frame_eqs_eel": "decay = 0;\nxx1 = xx1*0.9 + (bass)*0.01;\nxx2 = xx2*0.9 + (treb)*0.01;\nyy1 = yy1*0.94 + (treb+bass)*0.0075;\n\nx1 = 0.5 + (xx1-xx2)*3;\ny1 = 1 - yy1*0.75;\n\nspring = 20;\ngrav = .65-0.25*yy1;\nresist = 0.03;\nbounce = 1;//0.5;\ndt = 0.0005;\n\nspx2 = (x1+x3-2*x2)*spring;\nspy2 = (y1+y3-2*y2)*spring;\nspx3 = (x2+x4-2*x3)*spring;\nspy3 = (y2+y4-2*y3)*spring;\nspx4 = (x3-x4)*spring;\nspy4 = (y3-y4)*spring;\n\nvx2 = vx2*(1-resist) + dt*(spx2);\nvy2 = vy2*(1-resist) + dt*(spy2-grav);\nvx3 = vx3*(1-resist) + dt*(spx3);\nvy3 = vy3*(1-resist) + dt*(spy3-grav*1.5);\nvx4 = vx4*(1-resist) + dt*(spx4);\nvy4 = vy4*(1-resist) + dt*(spy4-grav*4);\n\nx2 = x2 + vx2;\ny2 = y2 + vy2;\nx3 = x3 + vx3;\ny3 = y3 + vy3;\nx4 = x4 + vx4;\ny4 = y4 + vy4;\n\nvx2 = if(above(x2,0),vx2,abs(vx2)*bounce);\nvx2 = if(below(x2,1),vx2,-abs(vx2)*bounce);\nvx3 = if(above(x3,0),vx3,abs(vx3)*bounce);\nvx3 = if(below(x3,1),vx3,-abs(vx3)*bounce);\nvx4 = if(above(x4,0),vx4,abs(vx4)*bounce);\nvx4 = if(below(x4,1),vx4,-abs(vx4)*bounce);\n\nvy2 = if(above(y2,0),vy2,abs(vy2)*bounce);\nvy2 = if(below(y2,1),vy2,-abs(vy2)*bounce);\nvy3 = if(above(y3,0),vy3,abs(vy3)*bounce);\nvy3 = if(below(y3,1),vy3,-abs(vy3)*bounce);\nvy4 = if(above(y4,0),vy4,abs(vy4)*bounce);\nvy4 = if(below(y4,1),vy4,-abs(vy4)*bounce);\n\n\nq1 = x1;\nq2 = x2;\nq3 = x3;\nq4 = x4;\n\nq5 = y1;\nq6 = y2;\nq7 = y3;\nq8 = y4;\nq2 = sin(+atan2(x4-x3,y4-y3) - asin(1)*2)*0.2;\nmonitor = q2;\n\n\nzoom = 1;\nq10 = aspectx;\nq11 = aspecty;\nwave_a = 0;",
