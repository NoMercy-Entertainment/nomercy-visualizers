		"init_eqs_eel": "zoom=1;\nxpos=0;\nypos=0;",
		"frame_eqs_eel": "decay=0.9;\n\nvol= (bass+mid+treb)*0.25;\nvol=vol*vol;\n\n\nob_r = 0.5 + 0.4*sin(time*1.324);\nob_g = 0.5 + 0.4*cos(time*1.371);\nob_b = 0.5+0.4*sin(2.332*time);\nib_r = 0.5 + 0.25*sin(time*1.424);\nib_g = 0.25 + 0.25*cos(time*1.871);\nib_b = 1-ob_b;\n\nmonitor=yspeed;\n\nzoom=1;\n\nmusictime=musictime+vol*(45/fps);\nq4=sin(musictime*0.02)*0.3;\nq5=sin(musictime*0.01)*0.3;\n\ndx=sin(musictime*0.1)*0.1;\ndy=cos(musictime*0.069)*0.1;",
